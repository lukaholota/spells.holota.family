model PersAdditionalUser {
  persAdditionalUserId Int      @id @default(autoincrement()) @map("pers_additional_user_id")
  persId               Int      @map("pers_id")
  userId               Int      @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")

  pers Pers @relation(fields: [persId], references: [persId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([persId, userId])
  @@index([userId])
  @@map("pers_additional_users")
}
